<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyRent</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --easyrent-teal: #20515d;
            --easyrent-teal-light: #2f7585;
            --easyrent-teal-glow: rgba(32, 81, 93, 0.15);
            --dark-navy: #1e293b;
            --soft-bg: #f8fafc;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--soft-bg);
            color: var(--dark-navy);
        }

        .split-container {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* ─── Left: Branding Panel ─── */
        .image-section {
            flex: 1.2;
            background: linear-gradient(160deg, rgba(32, 81, 93, 0.85) 0%, rgba(20, 50, 58, 0.98) 100%),
                        url('https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?auto=format&fit=crop&q=80&w=1920');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 72px;
            color: white;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.13);
            padding: 40px 44px;
            border-radius: 20px;
            max-width: 460px;
        }

        .glass-card h1 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            line-height: 1.15;
        }

        .glass-card p {
            opacity: 0.78;
            font-size: 0.97rem;
            line-height: 1.6;
        }

        .feature-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 0.82rem;
            opacity: 0.82;
        }

        .feature-badge i { color: #5eead4; }

        /* ─── Right: Form Panel ─── */
        .form-section {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            padding: 48px 40px;
            box-shadow: -8px 0 28px rgba(0, 0, 0, 0.04);
            z-index: 10;
            overflow-y: auto;
        }

        .form-card {
            width: 100%;
            max-width: 400px;
        }

        /* ─── Brand Logo ─── */
        .brand-logo {
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            font-size: 1.6rem;
            color: var(--easyrent-teal);
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 9px;
            letter-spacing: -0.4px;
            text-decoration: none;
        }

        .brand-logo:hover { color: var(--easyrent-teal); text-decoration: none; }
        .brand-logo img { height: 30px; width: auto; }

        /* ─── Page Heading ─── */
        .auth-heading {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--dark-navy);
            margin-bottom: 4px;
        }

        .auth-subtext {
            font-size: 0.88rem;
            color: #64748b;
            margin-bottom: 0;
        }

        /* ─── Form Labels ─── */
        .form-label {
            font-size: 0.82rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 6px;
            letter-spacing: 0.01em;
        }

        /* Hide browser default password reveal and clear buttons */
        input::-ms-reveal,
        input::-ms-clear {
            display: none;
        }

        /* ─── Input Group (Integrated design) ─── */
        .input-group {
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            background-color: #ffffff;
            transition: border-color 0.18s ease, box-shadow 0.18s ease;
            overflow: hidden;
            position: relative;
        }

        .input-group:focus-within {
            border-color: var(--easyrent-teal);
            box-shadow: 0 0 0 3px var(--easyrent-teal-glow);
        }

        .form-control {
            border: none !important;
            background-color: transparent !important;
            padding: 11px 16px;
            font-size: 0.92rem;
            color: var(--dark-navy);
            box-shadow: none !important;
            border-radius: 10px !important;
        }

        .form-control:focus {
            outline: none;
            box-shadow: none !important;
        }

        /* ─── Password Toggle Button (Seamless) ─── */
        .btn-pw-toggle {
            background: transparent;
            border: none;
            color: #94a3b8;
            padding: 0 14px;
            cursor: pointer;
            font-size: 1.1rem;
            line-height: 1;
            transition: color 0.18s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            outline: none;
            z-index: 5;
        }

        .btn-pw-toggle:hover {
            color: var(--easyrent-teal);
        }

        .btn-pw-toggle:focus {
            outline: none;
            box-shadow: none;
        }

        /* ─── Submit Button ─── */
        .btn-auth-submit {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.95rem;
            background-color: var(--easyrent-teal);
            color: #ffffff;
            border: none;
            cursor: pointer;
            transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
            letter-spacing: 0.01em;
        }

        .btn-auth-submit:hover {
            background-color: var(--easyrent-teal-light);
            transform: translateY(-1px);
            box-shadow: 0 4px 14px var(--easyrent-teal-glow);
            color: #ffffff;
        }

        .btn-auth-submit:active {
            transform: translateY(0);
        }

        /* ─── Teal Links ─── */
        .auth-link {
            color: var(--easyrent-teal);
            font-weight: 600;
            text-decoration: none;
            transition: color 0.15s;
        }

        .auth-link:hover {
            color: var(--easyrent-teal-light);
            text-decoration: underline;
        }

        /* ─── Remember Me Checkbox ─── */
        .form-check-input:checked {
            background-color: var(--easyrent-teal);
            border-color: var(--easyrent-teal);
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 3px var(--easyrent-teal-glow);
            border-color: var(--easyrent-teal);
        }

        /* ─── Alert Banner ─── */
        .alert-auth {
            border-radius: 10px;
            font-size: 0.87rem;
            padding: 10px 14px;
        }

        /* ─── Icon badge on Forgot/Reset pages ─── */
        .auth-icon-badge {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background-color: var(--easyrent-teal-glow);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: var(--easyrent-teal);
            margin-bottom: 16px;
        }

        /* ─── Divider ─── */
        .auth-divider {
            border-color: #f1f5f9;
            margin: 20px 0;
        }

        /* ─── Responsive ─── */
        @@media (max-width: 991px) {
            .split-container { flex-direction: column; height: auto; min-height: 100vh; }
            .image-section { flex: none; padding: 40px 24px; min-height: 220px; }
            .form-section { padding: 32px 24px; align-items: flex-start; }
        }
    </style>
</head>
<body>
    <div class="split-container">
        <!-- Left: Branding -->
        <div class="image-section">
            <div class="glass-card">
                <h1 class="display-5 mb-3">Your Journey <br>Starts Here.</h1>
                <p>Experience premium SUV and Van rentals with EasyRent. Our specialized fleet offers comfort, space, and reliability for every trip.</p>
                <div class="d-flex gap-4 mt-4 flex-wrap">
                    <div class="feature-badge">
                        <i class="bi bi-shield-check-fill"></i>
                        <span>Verified Fleet</span>
                    </div>
                    <div class="feature-badge">
                        <i class="bi bi-headset"></i>
                        <span>24/7 Support</span>
                    </div>
                    <div class="feature-badge">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <span>Instant Booking</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Form -->
        <div class="form-section">
            <div class="form-card">
                <a href="/" class="brand-logo">
                    <img src="/images/logo.png" alt="EasyRent Logo"> EasyRent
                </a>
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // ─── Reusable Password Toggle (used by all auth pages) ───
        function setupPwToggle(btnId, inputId) {
            var btn = document.getElementById(btnId);
            var input = document.getElementById(inputId);
            if (!btn || !input) return;

            btn.addEventListener('click', function () {
                var isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                var icon = btn.querySelector('i');
                if (icon) {
                    icon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
                }
                btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
                // Keep focus on the input after toggle
                input.focus();
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>