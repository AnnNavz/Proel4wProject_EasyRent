@model Proel4wProject_EasyRent.Models.Users
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Create Account - EasyRent";
}

<div class="mb-4">
    <h2 class="auth-heading">Get Started</h2>
    <p class="auth-subtext">Create your account to start exploring our fleet.</p>
</div>

<form asp-action="Register" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

    @* ── Name Row ── *@
    <div class="row g-3 mb-3">
        <div class="col-6">
            <label class="form-label">First Name</label>
            <div class="input-group">
                <input asp-for="UserFirstName" class="form-control" placeholder="First Name" required />
            </div>
            <span asp-validation-for="UserFirstName" class="text-danger small"></span>
        </div>
        <div class="col-6">
            <label class="form-label">Last Name</label>
            <div class="input-group">
                <input asp-for="UserLastName" class="form-control" placeholder="Last Name" required />
            </div>
            <span asp-validation-for="UserLastName" class="text-danger small"></span>
        </div>
    </div>

    @* ── Email ── *@
    <div class="mb-3">
        <label class="form-label">Email Address</label>
        <div class="input-group">
            <input asp-for="UserEmail" type="email" class="form-control" placeholder="Email Address" autocomplete="email" required />
        </div>
        <span asp-validation-for="UserEmail" class="text-danger small"></span>
    </div>

    @* ── Password ── *@
    <div class="mb-3">
        <label class="form-label">Password</label>
        <div class="input-group">
            <input asp-for="Password"
                   id="Password"
                   type="password"
                   class="form-control"
                   placeholder="Password"
                   autocomplete="new-password"
                   required />
            <button class="btn-pw-toggle" type="button" id="togglePassword" aria-label="Show password">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    @* ── Confirm Password ── *@
    <div class="mb-4">
        <label class="form-label">Confirm Password</label>
        <div class="input-group">
            <input asp-for="ConfirmPassword"
                   id="ConfirmPassword"
                   type="password"
                   class="form-control"
                   placeholder="Confirm Password"
                   autocomplete="new-password"
                   required />
            <button class="btn-pw-toggle" type="button" id="toggleConfirmPassword" aria-label="Show confirm password">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn-auth-submit mb-3">
        Create Account <i class="bi bi-arrow-right ms-2"></i>
    </button>

    <hr class="auth-divider">

    <p class="text-center small text-muted mb-0">
        Already have an account?
        <a asp-controller="Account" asp-action="LoginView" class="auth-link ms-1">Sign In</a>
    </p>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setupPwToggle('togglePassword', 'Password');
            setupPwToggle('toggleConfirmPassword', 'ConfirmPassword');
        });
    </script>
}