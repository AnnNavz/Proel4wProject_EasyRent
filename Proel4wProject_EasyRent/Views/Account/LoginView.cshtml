@using Proel4wProject_EasyRent.Models.ViewModels
@model LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login - EasyRent";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small py-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" style="padding: 0.8rem 1rem;" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-4 text-center">
    <div class="mb-3">
        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle" style="width: 64px; height: 64px;">
            <i class="bi bi-car-front-fill text-primary" style="font-size: 2rem;"></i>
        </div>
    </div>
    <h2 class="fw-bold h3 mb-1">Welcome to EasyRent</h2>
    <p class="text-primary small fw-bold text-uppercase tracking-wide mb-2" style="letter-spacing: 1px;">Car Rental Reservation System</p>
    <p class="text-muted">Enter your credentials to access your account.</p>
</div>

<form asp-action="Login" method="post" class="needs-validation">
    <div asp-validation-summary="ModelOnly" class="text-danger fw-semibold small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
        <div class="input-group">
            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
            <input asp-for="Email" class="form-control border-start-0" placeholder="name@email.com" required aria-label="Email Address" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <label asp-for="Password" class="form-label small fw-semibold text-secondary mb-0"></label>
            <a asp-controller="Account" asp-action="ForgotPassword" class="text-primary text-decoration-none small fw-medium" aria-label="Forgot your password?">Forgot password?</a>
        </div>
        <div class="input-group">
            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
            <input asp-for="Password" class="form-control border-start-0 border-end-0" type="password" placeholder="••••••••" required aria-label="Password" />
            <button class="btn btn-outline-secondary border-start-0 text-muted" type="button" id="togglePassword" aria-label="Toggle password visibility">
                <i class="bi bi-eye" id="togglePasswordIcon"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-4 d-flex align-items-center">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
            <label asp-for="RememberMe" class="form-check-label small text-muted" for="rememberMeCheck">Keep me signed in</label>
        </div>
    </div>

    <button type="submit" class="btn btn-primary w-100 shadow-sm py-2 mb-3 fw-semibold transition-all">
        Sign In <i class="bi bi-box-arrow-in-right ms-2"></i>
    </button>

    <div class="text-center mt-3">
        <p class="small text-muted">
            Don't have an account?
            <a asp-controller="Register" asp-action="Register" class="text-primary text-decoration-none fw-bold ms-1">Create an account</a>
        </p>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggleBtn = document.getElementById('togglePassword');
            const inputField = document.getElementById('Password');
            const icon = document.getElementById('togglePasswordIcon');

            if (toggleBtn && inputField && icon) {
                toggleBtn.addEventListener('click', function () {
                    const isPassword = inputField.type === 'password';
                    inputField.type = isPassword ? 'text' : 'password';
                    icon.classList.toggle('bi-eye', !isPassword);
                    icon.classList.toggle('bi-eye-slash', isPassword);
                    
                    // Update aria-label for accessibility
                    toggleBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
                });
            }
        });
    </script>
}