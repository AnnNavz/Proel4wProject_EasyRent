@using Proel4wProject_EasyRent.Models.ViewModels
@model LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login - EasyRent";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-auth alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Message"]
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-4">
    <h2 class="auth-heading">Welcome Back</h2>
    <p class="auth-subtext">Sign in to manage your rentals.</p>
</div>

<form asp-action="Login" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

    @* ── Email ── *@
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email Address</label>
        <div class="input-group">
            <input asp-for="Email"
                   class="form-control"
                   type="email"
                   placeholder="Email Address"
                   autocomplete="email"
                   value=""
                   required />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    @* ── Password ── *@
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <div class="input-group">
            <input asp-for="Password"
                   id="Password"
                   class="form-control"
                   type="password"
                   placeholder="Password"
                   autocomplete="current-password"
                   value=""
                   required />
            <button class="btn-pw-toggle" type="button" id="togglePassword" aria-label="Show password">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    @* ── Remember Me & Forgot Password ── *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check mb-0">
            <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
            <label class="form-check-label small text-muted" for="rememberMeCheck">Keep me signed in</label>
        </div>
        <a asp-controller="Account" asp-action="ForgotPassword" class="auth-link" style="font-size: 0.82rem;">Forgot password?</a>
    </div>

    <button type="submit" class="btn-auth-submit mb-3">
        Sign In <i class="bi bi-box-arrow-in-right ms-2"></i>
    </button>

    <hr class="auth-divider">

    <p class="text-center small text-muted mb-0">
        Don't have an account?
        <a asp-controller="Register" asp-action="Register" class="auth-link ms-1">Create an account</a>
    </p>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setupPwToggle('togglePassword', 'Password');
        });
    </script>
}