@model ResetPasswordViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Reset Password - EasyRent";
}

<div class="auth-icon-badge">
    <i class="bi bi-key"></i>
</div>

<div class="mb-4">
    <h2 class="auth-heading">Set New Password</h2>
    <p class="auth-subtext">Choose a strong password — at least 12 characters with uppercase, lowercase, numbers, and a symbol.</p>
</div>

<form asp-action="ResetPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

    @* Hidden context fields *@
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />

    @* ── New Password ── *@
    <div class="mb-3">
        <label class="form-label">New Password</label>
        <div class="input-group">
            <input asp-for="NewPassword"
                   id="NewPassword"
                   class="form-control"
                   type="password"
                   placeholder="Enter new password"
                   autocomplete="new-password"
                   required />
            <button class="btn-pw-toggle" type="button" id="toggleNewPassword" aria-label="Show new password">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    @* ── Confirm New Password ── *@
    <div class="mb-4">
        <label class="form-label">Confirm New Password</label>
        <div class="input-group">
            <input asp-for="ConfirmPassword"
                   id="ConfirmPassword"
                   class="form-control"
                   type="password"
                   placeholder="Repeat new password"
                   autocomplete="new-password"
                   required />
            <button class="btn-pw-toggle" type="button" id="toggleConfirmPassword" aria-label="Show confirm password">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn-auth-submit mb-3">
        Update Password <i class="bi bi-check-circle ms-2"></i>
    </button>

    <hr class="auth-divider">

    <p class="text-center small text-muted mb-0">
        Remembered your password?
        <a asp-controller="Account" asp-action="LoginView" class="auth-link ms-1">Back to Sign In</a>
    </p>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setupPwToggle('toggleNewPassword', 'NewPassword');
            setupPwToggle('toggleConfirmPassword', 'ConfirmPassword');
        });
    </script>
}