@model ForgotPasswordViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Forgot Password - EasyRent";
}

<div class="auth-icon-badge">
    <i class="bi bi-shield-lock"></i>
</div>

<div class="mb-4">
    <h2 class="auth-heading">Forgot Password?</h2>
    <p class="auth-subtext">Enter your registered email and we'll help you reset your password.</p>
</div>

<form asp-action="ForgotPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

    @* ── Email ── *@
    <div class="mb-4">
        <label asp-for="Email" class="form-label">Email Address</label>
        <div class="input-group">
            <input asp-for="Email"
                   class="form-control"
                   type="email"
                   placeholder="Email Address"
                   autocomplete="email"
                   required />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn-auth-submit mb-3">
        Send Reset Link <i class="bi bi-envelope-at ms-2"></i>
    </button>

    <hr class="auth-divider">

    <p class="text-center small text-muted mb-0">
        Remember your password?
        <a asp-action="LoginView" class="auth-link ms-1">Back to Sign In</a>
    </p>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}